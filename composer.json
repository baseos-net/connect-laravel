{
    "name": "baseos/connect-laravel",
    "description": "BaseOS Connect integration package for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": ["baseos", "connect", "laravel", "headless", "publishing", "multi-tenant"],
    "homepage": "https://baseos.net/connect",
    "authors": [
        {
            "name": "Base OS",
            "homepage": "https://baseos.net"
        }
    ],
    "support": {
        "source": "https://github.com/baseos-net/connect-laravel",
        "issues": "https://github.com/baseos-net/connect-laravel/issues"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BaseOS\\Connect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BaseOS\\Connect\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BaseOS\\Connect\\BridgeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
